# Base de dados (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Auth0 (resource server — validação de JWT)
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=https://<audience-identifier>/
# Claim namespaced onde o Auth0 do tenant real expõe os roles do back-office (ver TASK-007)
AUTH0_ROLES_CLAIM=https://diamondcars/roles

# Segurança — CORS (origem(ns) do dcbo autorizadas a chamar esta API, separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Propagação para o catalog-backend
CATALOG_SYNC_URL=http://localhost:8081
CATALOG_SYNC_TOKEN=

PORT=8080
