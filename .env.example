# Base de dados (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Auth0 (resource server — validação de JWT)
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=https://<audience-identifier>/

# Propagação para o catalog-backend
CATALOG_SYNC_URL=http://localhost:8081
CATALOG_SYNC_TOKEN=

PORT=8080
